---
config:
  layout: elk
  theme: default
---
classDiagram
    class QuestionBankSystem {
        +uploadQuestionBank(file)
        +generateSurvey(requirements)
        +analyzeResults(surveyData)
    }
    
    class QuestionBank {
        -String bankId
        -List~Question~ questions
        +addQuestion(question)
        +getQuestionsByCategory(category)
        +reclassifyQuestions()
    }
    
    class Question {
        -String questionId
        -String text
        -String type
        -String category
        -int difficulty
        -String language
        -List~String~ options
    }
    
    class WebCrawler {
        -List~Question~ allQuestions
        +crawl_all()
        +parse_survey_page(html, url, source_name)
        +save_all()
    }
    
    class DataProcessor {
        +clean_question_text(text)
        +normalize_for_dedup(text, lang)
        +calculate_difficulty(row)
        +load_and_process_data(filepath)
    }
    
    class CategoryClassifier {
        -Dict category_keywords
        +reclassify_general_by_keywords(df, category_keywords)
    }
    
    class TextMiningModel {
        +categorizeQuestions(questions)
        +extractKeywords(text)
        +analyzeRequirements(requirements)
    }
    
    class SurveyGenerator {
        -SurveyRequirement requirements
        +generate_survey(df, lang, target_count)
        +generate_questionnaire(req_path, db_path)
    }
    
    class SurveyRequirement {
        -int questionCount
        -List~String~ categories
        -String language
        -String userInput
    }
    
    class DataVisualizer {
        +plot_difficulty_distribution()
        +plot_category_distribution()
        +plot_question_type_distribution()
    }
    
    class FileExporter {
        +export_to_json(questions, filepath)
        +export_to_txt(questions, filepath)
    }
    
    class TFIDFEngine {
        +fit_transform(text_data, lang)
        +calculate_similarity(req_vector, tfidf_matrix)
    }

    %% Core Management
    QuestionBankSystem --> QuestionBank : manages
    QuestionBankSystem --> WebCrawler : controls
    QuestionBankSystem --> DataProcessor : coordinates
    QuestionBankSystem --> SurveyGenerator : orchestrates
    QuestionBankSystem --> DataVisualizer : utilizes
    
    %% Data Collection & Storage
    QuestionBank "1" --> "*" Question : contains
    WebCrawler --> DataProcessor : provides raw data
    
    %% Data Processing Pipeline
    DataProcessor --> CategoryClassifier : sends for classification
    DataProcessor --> TextMiningModel : sends for analysis
    CategoryClassifier --> QuestionBank : stores categorized
    TextMiningModel --> Question : analyzes content
    
    %% Survey Generation Flow
    SurveyGenerator --> QuestionBank : selects from
    SurveyGenerator --> SurveyRequirement : follows
    SurveyGenerator --> TFIDFEngine : uses for matching
    SurveyGenerator --> FileExporter : outputs through
    
    %% Analysis & Visualization
    DataVisualizer --> SurveyGenerator : visualizes results
    TFIDFEngine --> TextMiningModel : utilizes NLP
