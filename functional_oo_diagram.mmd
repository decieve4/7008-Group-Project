---
config:
  layout: dagre
  theme: mc
---
classDiagram
    %% Core System Classes
    class SurveySystem {
        +uploadQuestionBank(file)
        +generateSurvey(requirements)
        +analyzeResults(surveyData)
    }
    
    class WebApplication {
        -Flask app
        +index()
        +download_json()
        +download_txt()
        +build_requirements_json()
    }
    
    %% Data Layer Classes
    class QuestionBank {
        -List~Question~ questions
        +addQuestion(question)
        +getQuestionsByCategory(category)
        +reclassifyQuestions()
    }
    
    class Question {
        -String questionId
        -String text
        -String type
        -String category
        -int difficulty
        -String language
        -List~String~ options
    }
    
    class SurveyRequirement {
        -int questionCount
        -List~String~ categories
        -String language
        -String userInput
    }
    
    %% Processing Engine Classes
    class DataCollector {
        +crawl_web_data()
        +parse_survey_pages()
        +extract_questions()
    }
    
    class DataProcessor {
        +clean_question_text()
        +normalize_for_dedup()
        +calculate_difficulty()
        +load_and_process_data()
    }
    
    class CategoryClassifier {
        -Dict category_keywords
        +reclassify_general_by_keywords()
        +categorize_question()
    }
    
    class SurveyGenerator {
        -TFIDFEngine vectorizer
        +generate_questionnaire()
        +calculate_cosine_similarity()
    }
    
    class DataAnalyzer {
        +analyze_dataset_content()
        +plot_difficulty_distribution()
        +plot_category_distribution()
        +plot_question_type_distribution()
    }
    
    class FileExporter {
        +export_to_json()
        +export_to_txt()
    }
    
    %% Core System Relationships
    WebApplication --> SurveySystem : User Interaction
    SurveySystem --> QuestionBank : Manages
    SurveySystem --> SurveyGenerator : Generates Surveys
    SurveySystem --> DataAnalyzer : Analyzes Results
    
    %% Data Processing Pipeline
    DataCollector --> QuestionBank : Collects Data
    DataProcessor --> QuestionBank : Cleans & Processes
    CategoryClassifier --> QuestionBank : Classifies & Tags
    
    %% Survey Generation Flow
    SurveyRequirement --> SurveyGenerator : Input Requirements
    QuestionBank --> SurveyGenerator : Provides Questions
    SurveyGenerator --> FileExporter : Outputs Results
    
    %% Component Dependencies
    DataProcessor --> CategoryClassifier : Uses Classifier
    DataAnalyzer --> Question : Analyzes Features
